<Window x:Class="DesktopLyric.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="640" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Noto Sans HK Medium, Microsoft JhengHei UI, Segoe UI"
        MouseLeftButtonDown="Window_Drag">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00d4ff"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#70A0B0C0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="42" Height="22"
                                    CornerRadius="11" Background="#28FFFFFF" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#C8D0D8"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"
                                              TextBlock.Foreground="#E8EEF4" TextBlock.FontSize="13"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00d4ff"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0a0a12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRow" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3300d4ff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#00d4ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#FF1A1A28"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#C8D4E0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,7,32,7"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextBlock.Foreground="#F2F4F8"/>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Padding="4"
                                        Background="#FF161622"
                                        BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderThickness="1" Margin="8">
        <Border.BorderBrush>
            <SolidColorBrush Color="#28FFFFFF"/>
        </Border.BorderBrush>
        <Border.Background>
            <SolidColorBrush Color="#F20d0d18"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="24" Opacity="0.45" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click"
                        Background="Transparent" Foreground="#70FFFFFF"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Width="28" Height="28"/>
                <TextBlock Text="設定" FontSize="16" FontWeight="Bold"
                           Foreground="#00d4ff" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="顯示" Style="{StaticResource Section}" Margin="0,4,0,8"/>

                    <CheckBox x:Name="ChkTrad" Content="繁體中文" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkHideTrans" Content="隱藏譯文" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkRomaji" Content="日文顯示羅馬拼音" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>

                    <TextBlock Text="中文字型" Foreground="#90A8B8" FontSize="11" Margin="0,10,0,6"/>
                    <ComboBox x:Name="CmbFont" SelectionChanged="Font_Changed"/>

                    <TextBlock Text="主題色" Foreground="#90A8B8" FontSize="11" Margin="0,12,0,6"/>
                    <WrapPanel x:Name="AccentHost" Orientation="Horizontal"/>

                    <TextBlock Text="Overlay" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="ChkTopmost" Content="置頂" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>
                    <CheckBox x:Name="ChkAlbum" Content="全屏用專輯版面（封面＋歌詞）" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>

                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="透明度" Foreground="#E8EEF4" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="40" Maximum="100"
                                Thumb.DragStarted="Slider_DragStarted"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock x:Name="LblOpacity" Grid.Column="2" Foreground="#90A8B8"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原文字級" Foreground="#E8EEF4" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SldOriginal" Grid.Column="1"
                                Minimum="0.55" Maximum="1.85" SmallChange="0.08"
                                Thumb.DragStarted="Slider_DragStarted"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock x:Name="LblOriginal" Grid.Column="2" Foreground="#90A8B8"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="譯文字級" Foreground="#E8EEF4" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SldTrans" Grid.Column="1"
                                Minimum="0.55" Maximum="1.85" SmallChange="0.08"
                                Thumb.DragStarted="Slider_DragStarted"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock x:Name="LblTrans" Grid.Column="2" Foreground="#90A8B8"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Content="重設字級" Click="ResetScale_Click"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            Background="#10FFFFFF" Foreground="#A0B0C0"
                            BorderBrush="#20FFFFFF" Padding="12,5" Cursor="Hand" FontSize="11"/>

                    <TextBlock Text="時機" Style="{StaticResource Section}"/>
                    <TextBlock Text="套用所有歌曲。單一首歌請用 overlay 嘅 ＋／−。"
                               Style="{StaticResource Hint}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="全域偏移" Foreground="#E8EEF4" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SldOffset" Grid.Column="1"
                                Minimum="-1000" Maximum="1000" SmallChange="50" TickFrequency="50"
                                IsSnapToTickEnabled="True"
                                Thumb.DragStarted="Slider_DragStarted"
                                Thumb.DragCompleted="Slider_DragCompleted"/>
                        <TextBlock x:Name="LblOffset" Grid.Column="2" Foreground="#90A8B8"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="系統" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="ChkStartup" Content="登入 Windows 時自動啟動" Style="{StaticResource ToggleSwitch}"
                              Checked="OnToggle" Unchecked="OnToggle"/>
                    <TextBlock Text="關閉主窗之後，可喺工作列右下角通知區域打開主視窗、設定或結束（圖示可能收喺 ^ 入面）。要釘選到工作列：主窗開住時右鍵程式圖示 → 釘選到工作列。"
                               Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtFolder" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="設定資料夾" Click="OpenFolder_Click"
                        Background="#10FFFFFF" Foreground="#A0B0C0"
                        BorderBrush="#20FFFFFF" Padding="14,7" Cursor="Hand"/>
                <Button Content="完成" Click="Close_Click" HorizontalAlignment="Right"
                        Background="#1800d4ff" Foreground="#00d4ff"
                        BorderBrush="#4000d4ff" Padding="18,7" Cursor="Hand"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
