<Window x:Class="DesktopLyric.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Lyric"
        Height="640" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize"
        MouseLeftButtonDown="Window_Drag">

    <Border CornerRadius="16" ClipToBounds="True" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#25FFFFFF" Offset="0"/>
                <GradientStop Color="#08FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                <GradientStop Color="#0a0a12" Offset="0"/>
                <GradientStop Color="#0d0d18" Offset="0.5"/>
                <GradientStop Color="#080810" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="22,14,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="─" Click="Minimize_Click"
                            Background="Transparent" Foreground="#50FFFFFF"
                            BorderThickness="0" FontSize="13" Cursor="Hand"
                            Width="30" Height="30"/>
                    <Button Content="✕" Click="Close_Click"
                            Background="Transparent" Foreground="#50FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="30" Height="30"/>
                </StackPanel>
                <TextBlock Text="Desktop Lyric" FontSize="16" FontWeight="Bold"
                           Foreground="#00d4ff" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Now Playing -->
            <Border Grid.Row="1" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                    BorderThickness="1" BorderBrush="#18FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0e0e18" Offset="0"/>
                        <GradientStop Color="#12121e" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Width="44" Height="44"
                            Background="#15FFFFFF" ClipToBounds="True">
                        <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtTitle" Text="waiting..."
                                   Foreground="#f0f0f5" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtArtist" Text=""
                                   Foreground="#6e7a8a" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,0,8">
                <Ellipse x:Name="StatusDot" Width="6" Height="6"
                         Fill="#333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="not connected"
                           Foreground="#4a5060" FontSize="10"/>
            </StackPanel>

            <!-- Lyrics -->
            <Border Grid.Row="3" CornerRadius="12" Padding="16,12" Margin="0,0,0,10"
                    BorderThickness="1" BorderBrush="#12FFFFFF">
                <Border.Background>
                    <SolidColorBrush Color="#0a0a12" Opacity="0.6"/>
                </Border.Background>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPrev" Text=""
                               FontSize="11.5" Foreground="#30FFFFFF"
                               TextAlignment="Center" Margin="0,0,0,6"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtRomaji" Text=""
                               FontSize="10" Foreground="#5090c0"
                               TextAlignment="Center" FontStyle="Italic"
                               Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtCurrent" Text="lyrics will show here"
                               FontSize="17" Foreground="#00d4ff" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtTrans" Text=""
                               FontSize="12.5" Foreground="#c0c8d8"
                               TextAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtNext" Text=""
                               FontSize="11.5" Foreground="#30FFFFFF"
                               TextAlignment="Center" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <WrapPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="overlay" Click="ToggleOverlay_Click"
                        Background="#0CFFFFFF" Foreground="#a0b0c0"
                        BorderBrush="#15FFFFFF" BorderThickness="1"
                        Padding="14,7" FontSize="11" Cursor="Hand" Margin="3">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="export lrc" Click="ExportLrc_Click"
                        Background="#0CFFFFFF" Foreground="#a0b0c0"
                        BorderBrush="#15FFFFFF" BorderThickness="1"
                        Padding="14,7" FontSize="11" Cursor="Hand" Margin="3">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="settings" Click="Settings_Click"
                        Background="#0CFFFFFF" Foreground="#a0b0c0"
                        BorderBrush="#15FFFFFF" BorderThickness="1"
                        Padding="14,7" FontSize="11" Cursor="Hand" Margin="3">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                    </Button.Resources>
                </Button>
            </WrapPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="made by Epi-1120" Foreground="#2a2a3a" FontSize="9.5"/>
                <TextBlock Text="  ·  " Foreground="#222" FontSize="9.5"/>
                <TextBlock x:Name="TxtVersion" Text="v0.9.0" Foreground="#3a4a5a" FontSize="9.5"/>
                <TextBlock x:Name="TxtTime" Text="" Foreground="#333" FontSize="9.5" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
