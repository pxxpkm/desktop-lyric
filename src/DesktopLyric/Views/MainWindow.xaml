<Window x:Class="DesktopLyric.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Lyric"
        Height="500" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="♪ now playing"
                       FontSize="11" Foreground="#555"/>
            <TextBlock x:Name="TxtTitle" Text="waiting..."
                       FontSize="20" Foreground="#e0e0e0" FontWeight="Bold"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtArtist" Text=""
                       FontSize="13" Foreground="#888" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtStatus" Text="not connected"
                       FontSize="10" Foreground="#444" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- current lyric line, big -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0">
            <TextBlock x:Name="TxtPrev" Text=""
                       FontSize="12" Foreground="#444"
                       TextAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtCurrent" Text=""
                       FontSize="18" Foreground="#00d4ff" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtTrans" Text=""
                       FontSize="13" Foreground="#bbb"
                       TextAlignment="Center" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtNext" Text=""
                       FontSize="12" Foreground="#444"
                       TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="TxtTime" Text=""
                   FontSize="10" Foreground="#333"
                   HorizontalAlignment="Right" Margin="0,0,24,12"/>

        <Button Grid.Row="2" Content="overlay" Click="ToggleOverlay_Click"
                HorizontalAlignment="Left" Margin="24,0,0,12"
                Background="#222" Foreground="#888" BorderThickness="0"
                Padding="10,4" FontSize="10" Cursor="Hand"/>
    </Grid>
</Window>
