<Window x:Class="DesktopLyric.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Lyric"
        Height="500" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="♪ now playing"
                       FontSize="11" Foreground="#555"/>
            <TextBlock x:Name="TxtTitle" Text="waiting..."
                       FontSize="20" Foreground="#e0e0e0" FontWeight="Bold"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtArtist" Text=""
                       FontSize="13" Foreground="#888" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtStatus" Text="not connected"
                       FontSize="10" Foreground="#444" Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,16"
                      VerticalScrollBarVisibility="Hidden">
            <TextBlock x:Name="TxtLyrics" Text=""
                       FontSize="13" Foreground="#aaa"
                       TextWrapping="Wrap" LineHeight="22"/>
        </ScrollViewer>
    </Grid>
</Window>
