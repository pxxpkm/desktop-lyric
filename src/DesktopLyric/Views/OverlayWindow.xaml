<Window x:Class="DesktopLyric.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics"
        Width="720" Height="160"
        MinWidth="300" MinHeight="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Left="200" Top="36"
        MouseLeftButtonDown="OnDrag"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <Grid>
        <!-- bg -->
        <Border x:Name="BgBorder" CornerRadius="14" Margin="6">
            <Border.Background>
                <SolidColorBrush Color="#080810" Opacity="0.88"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="24" Opacity="0.5" ShadowDepth="4"/>
            </Border.Effect>
        </Border>
        <!-- subtle border -->
        <Border CornerRadius="14" Margin="6" BorderThickness="0.8" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2000d4ff" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1500d4ff" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- content -->
        <Grid Margin="12,6,12,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- track info -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,6,12,0">
                <TextBlock Text="♪ " FontSize="10" Foreground="#4000d4ff" VerticalAlignment="Center"/>
                <TextBlock x:Name="OvTrackTitle" Text="" FontSize="10.5"
                           Foreground="#80e0e8f4" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                <TextBlock Text="  ·  " FontSize="9" Foreground="#25FFFFFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="OvTrackArtist" Text="" FontSize="10"
                           Foreground="#507090a0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
            </StackPanel>

            <!-- lyrics -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,2,24,2">
                <TextBlock x:Name="OvCurrent" Text=""
                           FontSize="24" FontWeight="Bold"
                           Foreground="#00d4ff"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="OvTrans" Text=""
                           FontSize="14" Foreground="#c8dde8"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="OvNext" Text=""
                           FontSize="11" Foreground="#35a0b0c0"
                           TextAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- control bar (hidden until hover) -->
            <Border Grid.Row="2" x:Name="ControlBar" Opacity="0.55"
                    CornerRadius="10" Background="#10FFFFFF" Margin="8,0,8,4"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="A−" Click="OnFontSmaller" Style="{x:Null}"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button Content="A+" Click="OnFontLarger" Style="{x:Null}"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button x:Name="BtnTrad" Content="繁" Click="OnToggleTrad" Style="{x:Null}"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button Content="✕" Click="OnClose" Style="{x:Null}"
                            Background="Transparent" Foreground="#60FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="24" Height="24"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
