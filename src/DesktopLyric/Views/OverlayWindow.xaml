<Window x:Class="DesktopLyric.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopLyric.Views"
        Title="Lyrics"
        Width="720" Height="176"
        MinWidth="300" MinHeight="140" MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Left="200" Top="36"
        FontFamily="Noto Sans HK Medium, Noto Sans HK, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="False"
        MouseLeftButtonDown="OnDrag"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        SizeChanged="OnWindowSizeChanged">

    <Grid>
        <!-- bg. No DropShadowEffect: layered window + Effect + 10Hz karaoke
             has been taking down wpfgfx with no dump. -->
        <Border CornerRadius="16" Margin="2" Background="#55000000" IsHitTestVisible="False"/>
        <Border x:Name="BgBorder" CornerRadius="14" Margin="6">
            <Border.Background>
                <SolidColorBrush Color="#080810" Opacity="0.88"/>
            </Border.Background>
        </Border>
        <!-- subtle border -->
        <Border CornerRadius="14" Margin="6" BorderThickness="0.8" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2000d4ff" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1500d4ff" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- content -->
        <Grid Margin="12,6,12,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- track info -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,6,12,0">
                <TextBlock Text="♪ " FontSize="10" Foreground="#4000d4ff" VerticalAlignment="Center"/>
                <TextBlock x:Name="OvTrackTitle" Text="" FontSize="10.5"
                           Foreground="#80e0e8f4" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                <TextBlock Text="  ·  " FontSize="9" Foreground="#25FFFFFF" VerticalAlignment="Center"/>
                <TextBlock x:Name="OvTrackArtist" Text="" FontSize="10"
                           Foreground="#507090a0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
            </StackPanel>

            <!-- lyrics fill leftover space; control bar stays below and is never covered -->
            <Grid x:Name="LyricsHost" Grid.Row="1" Margin="16,4,16,4" ClipToBounds="True">
                <!-- Rasterize lyrics off the layered HWND. DropShadow used to do this
                     (and also crash); BitmapCache isolates geometry without a blur. -->
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1.25" EnableClearType="False" SnapsToDevicePixels="False"/>
                </Grid.CacheMode>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:LyricLineView Grid.Row="0" x:Name="OvCurrent" FontSize="24" IsCurrent="True"
                                     ClipToBounds="True" Margin="0,0,0,4"/>
                <local:LyricLineView Grid.Row="1" x:Name="OvTrans" FontSize="16"
                                     ClipToBounds="True"
                                     Foreground="#C8DDE8" MinHeight="0" Margin="0,0,0,2"/>
                <local:LyricLineView Grid.Row="2" x:Name="OvNext" FontSize="12"
                                     ClipToBounds="True"
                                     Foreground="#70A0B0C0" MinHeight="0"/>
            </Grid>

            <!-- control bar (hidden until hover) -->
            <Border Grid.Row="2" x:Name="ControlBar" Opacity="0.55"
                    CornerRadius="10" Background="#10FFFFFF" Margin="8,0,8,4"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="−" Style="{x:Null}"
                            PreviewMouseLeftButtonDown="OnOffsetLaterDown"
                            PreviewMouseLeftButtonUp="OnOffsetHoldUp"
                            LostMouseCapture="OnOffsetHoldUp"
                            ToolTip="歌詞早咗：延遲顯示。撳一下 0.05s，長按加快（最多 ±5 分鐘）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="13" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,0,0"/>
                    <Button x:Name="BtnOffset" Content="±0.00s" Click="OnOffsetReset" Style="{x:Null}"
                            ToolTip="重設呢首歌嘅時機微調"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            MinWidth="88" Height="24" Margin="0,0,0,0" Padding="2,0"/>
                    <Button Content="＋" Style="{x:Null}"
                            PreviewMouseLeftButtonDown="OnOffsetEarlierDown"
                            PreviewMouseLeftButtonUp="OnOffsetHoldUp"
                            LostMouseCapture="OnOffsetHoldUp"
                            ToolTip="歌詞遲咗：提早顯示。撳一下 0.05s，長按加快（最多 ±5 分鐘）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="13" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,2,0"/>
                    <Button Content="調" Click="OnTimingEditor" Style="{x:Null}"
                            ToolTip="時機編輯：偏移＋快慢＋改詞＋停留（Live 版）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,6,0"/>
                    <Button Content="原−" Click="OnOriginalSmaller" Style="{x:Null}"
                            ToolTip="原文細啲（日文行）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,0,0"/>
                    <Button Content="原+" Click="OnOriginalLarger" Style="{x:Null}"
                            ToolTip="原文大啲（日文行）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,4,0"/>
                    <Button Content="譯−" Click="OnTransSmaller" Style="{x:Null}"
                            ToolTip="譯文細啲（中文行）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,0,0"/>
                    <Button Content="譯+" Click="OnTransLarger" Style="{x:Null}"
                            ToolTip="譯文大啲（中文行）"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,4,0"/>
                    <Button Content="A−" Click="OnFontSmaller" Style="{x:Null}"
                            ToolTip="成個字幕窗細啲"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button Content="A+" Click="OnFontLarger" Style="{x:Null}"
                            ToolTip="成個字幕窗大啲"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button x:Name="BtnTrad" Content="繁" Click="OnToggleTrad" Style="{x:Null}"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="28" Height="24" Margin="0,0,2,0"/>
                    <Button x:Name="BtnTopmost" Content="頂" Click="OnToggleTopmost" Style="{x:Null}"
                            ToolTip="置頂／取消置頂"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,2,0"/>
                    <Button Content="選" Click="OnPickSong" Style="{x:Null}"
                            ToolTip="同名歌揀正確版本"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,2,0"/>
                    <Button Content="全" Click="OnFullscreen" Style="{x:Null}"
                            ToolTip="全屏：專輯版面／全幕歌詞"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,2,0"/>
                    <Button Content="主" Click="OnShowMain" Style="{x:Null}"
                            ToolTip="顯示主視窗"
                            Background="Transparent" Foreground="#90FFFFFF"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Width="24" Height="24" Margin="0,0,2,0"/>
                    <Button Content="✕" Click="OnClose" Style="{x:Null}"
                            Background="Transparent" Foreground="#60FFFFFF"
                            BorderThickness="0" FontSize="10" Cursor="Hand"
                            Width="24" Height="24"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
