<Window x:Class="DesktopLyric.Views.PickSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="選擇歌詞"
        Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d18"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Noto Sans HK Medium, Microsoft JhengHei UI, Segoe UI"
        MouseLeftButtonDown="Window_Drag">

    <Border CornerRadius="0" BorderThickness="0" Margin="0">
        <Border.BorderBrush>
            <SolidColorBrush Color="#28FFFFFF"/>
        </Border.BorderBrush>
        <Border.Background>
            <SolidColorBrush Color="#0d0d18"/>
        </Border.Background>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click"
                        Background="Transparent" Foreground="#70FFFFFF"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Width="28" Height="28"/>
                <TextBlock Text="選擇歌詞" FontSize="16" FontWeight="Bold"
                           Foreground="#00d4ff" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="同名歌可能有不同版本。揀一條正確嘅，下次會記住。"
                       Foreground="#80A0B0C0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtTitle" Grid.Row="0" Grid.Column="0" Margin="0,0,4,0"
                         ToolTip="歌名。鎖住就唔跟播放器。"
                         Background="#18FFFFFF" Foreground="#F0F0F5" BorderBrush="#22FFFFFF"
                         CaretBrush="#00d4ff" Padding="8,7" FontSize="12"
                         FontFamily="Yu Gothic UI, Meiryo UI, Microsoft JhengHei UI, Segoe UI"
                         InputMethod.IsInputMethodEnabled="True"
                         KeyDown="SearchBox_KeyDown"/>
                <ToggleButton x:Name="ChkLockTitle" Grid.Row="0" Grid.Column="1"
                              Content="鎖" Margin="0,0,8,0" Padding="8,6" Cursor="Hand"
                              ToolTip="鎖定歌名。播放器換歌都唔改呢格。"
                              Background="#10FFFFFF" Foreground="#A0B0C0"
                              BorderBrush="#20FFFFFF" Click="Lock_Click"/>
                <TextBox x:Name="TxtArtist" Grid.Row="0" Grid.Column="2" Margin="0,0,4,0"
                         ToolTip="歌手。鎖住就唔跟播放器。"
                         Background="#18FFFFFF" Foreground="#F0F0F5" BorderBrush="#22FFFFFF"
                         CaretBrush="#00d4ff" Padding="8,7" FontSize="12"
                         FontFamily="Yu Gothic UI, Meiryo UI, Microsoft JhengHei UI, Segoe UI"
                         InputMethod.IsInputMethodEnabled="True"
                         KeyDown="SearchBox_KeyDown"/>
                <ToggleButton x:Name="ChkLockArtist" Grid.Row="0" Grid.Column="3"
                              Content="鎖" Margin="0,0,8,0" Padding="8,6" Cursor="Hand"
                              ToolTip="鎖定歌手。播放器換歌都唔改呢格。"
                              Background="#10FFFFFF" Foreground="#A0B0C0"
                              BorderBrush="#20FFFFFF" Click="Lock_Click"/>
                <Button Grid.Row="0" Grid.Column="4" Content="搜尋" Click="Search_Click"
                        Background="#1800d4ff" Foreground="#00d4ff"
                        BorderBrush="#4000d4ff" Padding="14,7" Cursor="Hand"/>
                <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="讀取播放中" Click="ReadPlaying_Click"
                            ToolTip="用而家播放器嘅歌名／歌手填入未鎖嘅格，然後搜。"
                            Background="#10FFFFFF" Foreground="#A0B0C0"
                            BorderBrush="#20FFFFFF" Padding="10,5" Cursor="Hand"/>
                    <TextBlock Text="鎖住嘅格唔會跟播放器。字幕窗「鎖」可以鎖定 overlay 歌詞。"
                               Foreground="#70A0B0C0" FontSize="10.5" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>

            <TextBlock x:Name="TxtStatus" Grid.Row="3" VerticalAlignment="Top"
                       Foreground="#80A0B0C0" FontSize="12" Margin="4,0,0,0"/>
            <ListBox x:Name="LstResults" Grid.Row="3" Margin="0,22,0,0"
                     Background="#08FFFFFF" BorderBrush="#18FFFFFF"
                     Foreground="#F0F0F5" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     MouseDoubleClick="Use_Click">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F0F0F5"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3300d4ff"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7000d4ff"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#4500d4ff"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#F2F4F8" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="#90A8B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <CheckBox x:Name="ChkRemember" DockPanel.Dock="Left"
                          Content="記住呢首歌" IsChecked="True"
                          Foreground="#A0B0C0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="使用" Click="Use_Click"
                            Background="#1800d4ff" Foreground="#00d4ff"
                            BorderBrush="#4000d4ff" Padding="16,7" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="取消" Click="Close_Click"
                            Background="#10FFFFFF" Foreground="#A0B0C0"
                            BorderBrush="#20FFFFFF" Padding="16,7" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
